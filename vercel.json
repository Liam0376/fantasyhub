{
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/hub-api/(.*)", "destination": "/api/index.py" },
    { "source": "/recommendations/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/refresh", "destination": "/api/index.py" },
    { "source": "/draft", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}
